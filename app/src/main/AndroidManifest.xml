<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only what the app uses: Pleos App Market review accepts approved permissions only. The M0 probe's extra reads
         (and the rehearsal scripts' route cancel) are declared for debug builds in src/debug/AndroidManifest.xml. -->
    <!-- Pleos Vehicle SDK (read): brake pedal + distance driven (CAR_DRIVE), turn signal (CAR_LIGHTS), seat occupancy (CAR_SEATS) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Pleos NaviHelper SDK: guidance events (speed limit, cameras, caution points, TBT) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- AAOS properties through CarPropertyManager: PERF_VEHICLE_SPEED, GEAR_SELECTION, INFO_FUEL_TYPE -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- Demo: the Virtual Console (emulator) and the web pedal page, both on 127.0.0.1 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DriveService: the engine and the trip keep going while another app has the screen (Android 14 freezes cached apps) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The voice parts: a take only when the user taps record in the garage, parked (asked for then, not at start). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application
        android:name=".DownshiftApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Downshift">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Downshift">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Rehearsal and check hook (adb broadcast) used by tools/*.sh; see adapters/demo/DemoBus.kt. Only adb's shell
             and the system hold DUMP, so other apps on the head unit cannot send it demo commands. -->
        <receiver
            android:name=".adapters.demo.DemoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <service
            android:name=".DriveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
